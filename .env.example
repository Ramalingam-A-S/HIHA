# Application Environment Configuration Example
# Copy this file to .env.local for local overrides (never commit .env.local)

# Server Environment
NODE_ENV=development
PORT=3000

# Client Environment (Public)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Milestone 1.2+ Foundation)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Provide either publishable key (sb_publishable_...) or standard anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-Only Supabase Admin Key (Milestone 4.5 P0-3 Account Deletion & Storage Lifecycle)
# NEVER prefix with NEXT_PUBLIC_ or commit actual secret keys
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-to-browser
